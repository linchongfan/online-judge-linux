APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_SECRET
JUDGE_RESULT_SECRET=CHANGE_ME_JUDGE_SECRET
DATABASE_URL=mysql+pymysql://oj:CHANGE_ME_MYSQL@127.0.0.1:3306/xinbaoyan?charset=utf8mb4
REDIS_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/2
JUDGE_RESULT_REDIS_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=true
CORS_ORIGINS=https://__DOMAIN__
STORAGE_ROOT=/var/lib/xinbaoyan/data
SOURCE_CODE_MAX_BYTES=65536
TEST_DATA_MAX_COMPRESSED_BYTES=52428800
TEST_DATA_MAX_UNCOMPRESSED_BYTES=268435456
TEST_DATA_MAX_FILES=202
SUBMISSION_RATE_LIMIT=8
SUBMISSION_RATE_WINDOW_SECONDS=60
MAX_QUEUED_SUBMISSIONS_PER_USER=3
JUDGE_TASK_LEASE_SECONDS=120
JUDGE_TASK_QUEUE_TIMEOUT_SECONDS=600
JUDGE_TASK_MAX_ATTEMPTS=3
SMTP_HOST=CHANGE_ME_SMTP
SMTP_PORT=587
SMTP_FROM=noreply@__DOMAIN__
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
