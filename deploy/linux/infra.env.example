INFRA_MODE=external
MYSQL_DATABASE=xinbaoyan
MYSQL_USER=oj
MYSQL_PASSWORD=CHANGE_ME_MYSQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
REDIS_PASSWORD=CHANGE_ME_REDIS
# external：使用 1Panel/服务器已有的 MySQL 8.4.13 与 Redis 8.10.3。
# compose：由 deploy/linux/docker-compose.yml 在本机创建相同版本实例。
# 两种模式都只使用 127.0.0.1，不向公网开放数据库或 Redis。
