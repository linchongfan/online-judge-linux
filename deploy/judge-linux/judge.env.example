APP_ENV=production
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/1
JUDGE_RESULT_REDIS_URL=redis://:CHANGE_ME_REDIS@127.0.0.1:6379/0
JUDGE_RESULT_QUEUE=judge:results
JUDGE_RESULT_SECRET=CHANGE_ME_JUDGE_SECRET
JUDGE_HEARTBEAT_URL=http://127.0.0.1:8000/api/v1/internal/judge/heartbeat
JUDGE_HEARTBEAT_INTERVAL=10
JUDGE_WORKER_ID=judge-linux-01
JUDGE_ENV=production
JUDGE_SANDBOX_BACKEND=isolate
JUDGE_WORK_ROOT=/var/lib/xinbaoyan-judge/work
JUDGE_META_ROOT=/var/lib/xinbaoyan-judge/meta
JUDGE_LINUX_ROOTFS=/var/lib/xinbaoyan-judge/rootfs
JUDGE_ISOLATE_PATH=/usr/bin/isolate
JUDGE_ISOLATE_FIRST_UID=60000
JUDGE_ISOLATE_FIRST_GID=60000
JUDGE_ISOLATE_USER_IDS=100
JUDGE_PROCESS_LIMIT=64
JUDGE_COMPILE_PROCESS_LIMIT=32
JUDGE_DISK_BLOCKS=51200
JUDGE_DISK_INODES=4096
JUDGE_COMPILE_DISK_BLOCKS=204800
JUDGE_COMPILE_DISK_INODES=16384
JUDGE_GCC_PATH=/opt/judge-toolchains/gcc13/bin/gcc
JUDGE_GPP_PATH=/opt/judge-toolchains/gcc13/bin/g++
JUDGE_GXX_PATH=/opt/judge-toolchains/gcc13/bin/g++
JUDGE_JAVAC_PATH=/opt/judge-toolchains/jdk17/bin/javac
JUDGE_JAVA_PATH=/opt/judge-toolchains/jdk17/bin/java
JUDGE_USER_PYTHON_PATH=/opt/judge-toolchains/python312/bin/python3
