APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
JUDGE_RESULT_SECRET=replace-with-an-independent-random-secret
DATABASE_URL=mysql+pymysql://oj:change-me@127.0.0.1:3306/xinbaoyan?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_ROOT=./data
SOURCE_CODE_MAX_BYTES=65536
TEST_DATA_MAX_COMPRESSED_BYTES=52428800
TEST_DATA_MAX_UNCOMPRESSED_BYTES=268435456
TEST_DATA_MAX_FILES=202
# Linux 判题工具链：使用绝对路径，不依赖交互式 shell 的 PATH。
JUDGE_GCC_PATH=/usr/bin/gcc
JUDGE_GPP_PATH=/usr/bin/g++
JUDGE_GXX_PATH=/usr/bin/g++
JUDGE_JAVAC_PATH=/usr/lib/jvm/java-17-openjdk-amd64/bin/javac
JUDGE_JAVA_PATH=/usr/lib/jvm/java-17-openjdk-amd64/bin/java
JUDGE_PYTHON_PATH=/usr/bin/python3
JUDGE_USER_PYTHON_PATH=/usr/bin/python3
# 本机开发判题模式（不是生产沙箱）
JUDGE_ENV=development
JUDGE_ALLOW_UNSAFE_TESTS=1
